# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Frontend & Backend)
# Configura tu proyecto gratuito en https://supabase.com
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"
VITE_SUPABASE_ANON_KEY="tu-anon-key-publica"

# SUPABASE SERVICE ROLE KEY (Solo para Edge Functions y backend server-side, NUNCA en cliente)
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key-privada"

# WEB PUSH VAPID KEYS (Generadas automáticamente o personalizadas)
VAPID_PUBLIC_KEY="tu-clave-publica-vapid"
VAPID_PRIVATE_KEY="tu-clave-privada-vapid"
VAPID_SUBJECT="mailto:soporte@studyflow.app"
